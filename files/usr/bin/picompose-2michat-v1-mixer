#!/bin/sh
# The WM8960 starts with the DAC not routed to the outputs and the microphones not routed to the ADC.
# Switch the routing on, the volumes are left as they are.

CARD=seeed2micvoicec

i=0
while ! amixer -c "$CARD" info >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -gt 30 ]; then
        echo "Card $CARD not found, nothing to set"
        exit 0
    fi
    sleep 1
done

set_control() {
    amixer -q -c "$CARD" cset name="$1" "$2" || echo "Could not set '$1'"
}

set_control "Left Output Mixer PCM Playback Switch" on
set_control "Right Output Mixer PCM Playback Switch" on
set_control "Left Input Mixer Boost Switch" on
set_control "Right Input Mixer Boost Switch" on
set_control "Left Input Boost Mixer LINPUT1 Volume" 3
set_control "Right Input Boost Mixer RINPUT1 Volume" 3

exit 0
