#!/usr/bin/make -f

%:
	dh $@ --with dkms

override_dh_auto_build:
	for hat in 2mic 4mic 8mic; do \
	    dtc -@ -b 0 -Wno-unit_address_vs_reg -I dts -O dtb -o seeed-$$hat-voicecard.dtbo src/seeed-voicecard/seeed-$$hat-voicecard-overlay.dts; \
	done

override_dh_auto_clean:
	rm -f seeed-*-voicecard.dtbo

override_dh_dkms:
	dh_dkms -V 0.3

override_dh_installsystemd:
	dh_installsystemd --no-start --no-restart-after-upgrade seeed-voicecard.service
	dh_installsystemd --no-start --no-restart-after-upgrade configure_audio.service
