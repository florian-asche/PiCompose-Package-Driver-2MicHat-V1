#!/usr/bin/make -f

# The overlay is built from the repository of Seeed, at a fixed commit so builds are repeatable.
# To follow upstream, set SEEED_COMMIT to a newer commit of the default branch.
SEEED_REPOSITORY = https://github.com/Seeed-Studio/seeed-linux-dtoverlays.git
SEEED_COMMIT = 1d53c3cf2c96bd5ca2b2b7b9cbb198d398e4031c
SEEED_DIR = build/seeed-linux-dtoverlays

%:
	dh $@

override_dh_auto_build:
	rm -rf build
	mkdir build
	git init -q $(SEEED_DIR)
	cd $(SEEED_DIR) && git fetch -q --depth 1 $(SEEED_REPOSITORY) $(SEEED_COMMIT) && git checkout -q FETCH_HEAD
	cd $(SEEED_DIR) && make overlays/rpi/respeaker-2mic-v1_0-overlay.dtbo
	cp $(SEEED_DIR)/overlays/rpi/respeaker-2mic-v1_0-overlay.dtbo build/respeaker-2mic-v1_0.dtbo

override_dh_auto_clean:
	rm -rf build
